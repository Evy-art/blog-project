<div>
  <h1 class="font-bold text-4xl">Posts#show</h1>
  <p>Find me in app/views/posts/show.html.erb</p>
  <p><strong>Id: </strong> <%= @post.id%></p> 
  <p><strong>Title: </strong> <%= @post.title%></p>
  <p><strong> Body: </strong> <%= @post.body%></p>

  <div class="mt-4">
  <%= link_to "Edit Post", edit_post_path(@post), class: "bg-yellow-500 text-white px-4 py-2 rounded mr-2"%>
  <%= link_to "Back to Posts", posts_path, class: "bg-gray-500 text-white px-4 py-2 rounded" %>
  </div>
</div>
