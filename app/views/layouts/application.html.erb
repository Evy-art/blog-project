<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Video" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="Video">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <nav class="flex justify-between items-center bg-gray-800 text-white px-6 py-4">
  <div class="flex items-center gap-2">
  <% if user_signed_in? %>
  <%= link_to profile_path do %>
  <%= image_tag(
      current_user.avatar.attached? ? url_for(current_user.avatar) : asset_path("default-avatar.png"),
      class: "w-10 h-10 rounded-full border border-gray-300"
    ) %>
    <% end %>
    <span class="font-semibold"></span>
    <% else %>
    <div class ="font-bold text-lg">MyBlog</div>
    <% end %>
  </div>
  
  <div class="flex gap-3 items-center">
  <%if user_signed_in? %>
  <span class="text-sm">Hello, <%= current_user.email %></span>

  <%= button_to "Logout", destroy_user_session_path,
      method: :delete,
      class: "bg-red-600 hover:bg-red-500 px-3 py-2 rounded-md" %>
      <% else %>

      <%= link_to "Login", new_user_session_path, 
      class: "bg-gray-600 hover:bg-gray-500 px-3 py-2 rounded-md" %>
      <%= link_to "Sign Up", new_user_registration_path,
      class: "bg-blue-600 hover:bg-blue-500 rounded-md px-3 py-2" %>
      <% end %>

  </div>
  </nav>

  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "trix" %>

  <%= javascript_importmap_tags %>
  <%= javascript_include_tag "trix" %>
</head>

  <body>
    <main class="container mx-auto mt-28 px-5 flex">
      <%= yield %>
    </main>
  </body>
</html>
