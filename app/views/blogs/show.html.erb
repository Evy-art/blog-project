<% content_for :title, "Showing blog" %>

<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <% if notice.present? %>
    <p class="mb-6 inline-block rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700 shadow-sm" id="notice">
      <%= notice %>
    </p>
  <% end %>

  <div class="rounded-2xl border border-gray-200 bg-white p-6 sm:p-8 shadow-sm">
    <div class="mb-8">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">Showing blog</h1>
      <p class="mt-2 text-sm text-gray-500">View the full blog post and manage it below.</p>
    </div>

    <div class="prose prose-gray max-w-none">
      <%= render @blog %>
    </div>

    <div class="mt-8 flex flex-col gap-44 sm:gap-9 sm:flex-row sm:flex-wrap sm:items-center">
      <%= link_to "Edit this blog",
        edit_blog_path(@blog),
        class: "inline-flex w-full sm:w-auto items-center justify-center rounded-xl bg-gray-100 px-4 py-2.5 text-center font-medium text-gray-700 transition hover:bg-gray-200" %>

      <%= link_to "Back to blogs",
        blogs_path,
        class: "inline-flex w-full sm:w-auto items-center justify-center rounded-xl bg-gray-100 px-4 py-2.5 text-center font-medium text-gray-700 transition hover:bg-gray-200" %>

      <%= button_to "Destroy this blog",
        @blog,
        method: :delete,
        form_class: "w-full sm:w-auto",
        class: "inline-flex w-full items-center justify-center rounded-xl bg-red-600 px-4 py-2.5 font-medium text-white shadow-sm transition hover:bg-red-500 cursor-pointer",
        data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>
</div>