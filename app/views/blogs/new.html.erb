<% content_for :title, "New blog" %>

<div class="w-full md:px-70 sm:px-0">
<div class="rounded-2xl border border-gray-200 bg-white p-6 sm:p-8 shadow-sm">
  <h1 class="font-bold text-4xl">New blog</h1>

<div class="w-full flex justify-center md:mt-10">
  <div class="w-full max-w-2xl">
    <%= render "form", blog: @blog %>

    <!-- Buttons row -->
    <div class="-mt-13 flex flex-col sm:flex-row gap-2 sm:justify-end">
      <%= link_to "Back to blogs",
        blogs_path,
        class: "rounded-xl px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium text-center" %>
    </div>
    </div>
  </div>
</div>
