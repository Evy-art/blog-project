<% content_for :title, "Blogs" %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <% if notice.present? %>
    <p class="mb-6 inline-block rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700 shadow-sm">
      <%= notice %>
    </p>
  <% end %>

  <% if alert.present? %>
    <p class="mb-6 inline-block rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700 shadow-sm">
      <%= alert %>
    </p>
  <% end %>

  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">Blogs</h1>
    </div>

    <%= link_to "New blog", new_blog_path,
      class: "inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-blue-500 hover:shadow-lg" %>
  </div>

  <div id="blogs" class="space-y-8">
    <% if @blogs.any? %>

      <% @blogs.each do |blog| %>
        <div id="blog-<%= blog.id %>" class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:shadow-md">
          <div class="flex flex-col gap-6">

            <%= render blog %>

            <div class="flex flex-col gap-3">
  <%= link_to "Show", blog,
    class: "inline-flex w-fit items-center justify-center rounded-xl bg-gray-100 px-4 py-2.5 text-sm font-medium text-gray-700 transition hover:bg-gray-200" %>

  <% if user_signed_in? %>
    <details class="w-full group">
      <summary class="inline-flex w-fit cursor-pointer list-none items-center justify-center rounded-xl bg-green-100 px-4 py-2.5 text-sm font-medium text-green-800 shadow-sm transition hover:bg-green-200">
        Add Comment
      </summary>

      <div class="mt-4 rounded-2xl border border-gray-200 bg-gradient-to-br from-gray-50 to-white p-5 shadow-sm">
        <div class="mb-3">
          <h4 class="text-sm font-semibold text-gray-800">Join the discussion</h4>
          <p class="mt-1 text-xs text-gray-500">Share your thoughts about this blog post.</p>
        </div>

        <%= form_with(model: [blog, Comment.new], local: true, class: "space-y-4") do |f| %>
          <%= f.text_area :content,
            rows: 4,
            placeholder: "Write your comment...",
            class: "w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm leading-6 text-gray-800 shadow-sm transition placeholder:text-gray-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>

          <div class="flex justify-end">
            <%= f.submit "Post Comment",
              class: "inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-500 hover:shadow-md" %>
          </div>
        <% end %>
      </div>
    </details>
  <% else %>
    <p class="text-sm text-gray-500">
      You must
      <%= link_to "login", new_user_session_path, class: "font-medium text-blue-600 underline underline-offset-2 hover:text-blue-500" %>
      to comment.
    </p>
  <% end %>
</div>
            <div class="mt-2 rounded-2xl bg-gray-50 p-5 border border-gray-100">
              <h3 class="mb-4 text-lg font-semibold text-gray-800">Comments</h3>

              <% if blog.comments.any? %>
                <div class="space-y-4">

                  <% blog.comments.each do |comment| %>
                    <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
                      <p class="mb-3 text-sm leading-6 text-gray-700">
                        <strong class="mr-1 text-gray-900"><%= comment.user&.username %></strong>
                        <%= comment.content %>
                      </p>

                      <% if user_signed_in? && comment.user == current_user %>
                        <div class="flex flex-wrap gap-2">
                          <details class="inline-block w-full">
  <summary class="inline-flex cursor-pointer list-none items-center justify-center rounded-xl bg-yellow-100 px-3 py-1.5 text-sm font-medium text-yellow-800 shadow-sm transition hover:bg-yellow-200">
    Edit
  </summary>

  <div class="mt-3 rounded-2xl border border-gray-200 bg-gradient-to-br from-gray-50 to-white p-4 shadow-sm">
    
    <div class="mb-3">
      <h4 class="text-sm font-semibold text-gray-800">Edit your comment</h4>
      <p class="mt-1 text-xs text-gray-500">Make changes and save your update.</p>
    </div>

    <%= form_with(model: [blog, comment], local: true, class: "space-y-4") do |f| %>
      
      <%= f.text_area :content,
        rows: 4,
        class: "w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm leading-6 text-gray-800 shadow-sm transition placeholder:text-gray-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>

      <div class="flex justify-end gap-2">
        <%= f.submit "Save Changes",
          class: "inline-flex items-center justify-center rounded-xl bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-blue-500 hover:shadow-md" %>
      </div>

    <% end %>
  </div>
</details>
                          <%= button_to "Delete",
                          blog_comment_path(blog, comment),
                          method: :delete,
                          form: {
                            onsubmit: "return confirm('Are you sure?');"
                          },
                          class: "rounded-xl bg-red-100 px-3 py-1.5 text-sm font-medium text-red-700 transition hover:bg-red-200" %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>

                </div>
              <% else %>
                <p class="text-sm text-gray-500">No comments yet.</p>
              <% end %>
            </div>

          </div>
        </div>
      <% end %>

    <% else %>
      <div class="rounded-2xl border border-dashed border-gray-300 bg-white py-16 text-center shadow-sm">
        <p class="text-base text-gray-500">No blogs found.</p>
      </div>
    <% end %>
  </div>
</div>