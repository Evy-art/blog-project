<% content_for :title, "Blogs" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block">
      <%= notice %>
    </p>
  <% end %>

  <% if alert.present? %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-md inline-block">
      <%= alert %>
    </p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Blogs</h1>
    <%= link_to "New blog", new_blog_path,
      class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <div id="blogs" class="divide-y divide-gray-200">
    <% if @blogs.any? %>

      <% @blogs.each do |blog| %>
        <div id="blog-<%= blog.id %>" class="py-6">
          <div class="flex flex-col gap-4">

            <%= render blog %>

            <div class="flex flex-col sm:flex-row gap-2">
              <%= link_to "Show", blog,
                class: "text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium" %>

                  <% if user_signed_in? %>
                  <div class="flex flex-col sm:flex-row gap-2">
              <details class="w-full sm:w-auto">
                <summary class="cursor-pointer text-center rounded-md px-3.5 py-2.5 bg-green-100 hover:bg-green-200 font-medium text-green-800">
                  Add Comment
                </summary>

                <div class="mt-4 rounded-lg border border-gray-200 bg-gray-50 p-4">
                  <%= form_with(model: [blog, Comment.new], local: true, class: "space-y-3") do |f| %>
                    <%= f.text_area :content,
                      rows: 3,
                      placeholder: "Write your comment...",
                      class: "w-full rounded-md border border-gray-300 p-3 focus:ring-2 focus:ring-blue-500" %>

                    <%= f.submit "Post Comment",
                      class: "px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-md" %>
                  <% end %>
                </div>
              </details>
            </div>
            <% else %>
            <p class="text-gray-500">
            You must <%= link_to "login", new_user_session_path, class: "text-blue-600 underline" %> to comment.
            </p>
            <% end %>

            <div class="mt-2">
              <h3 class="text-base font-semibold text-gray-800 mb-2">Comments</h3>

              <% if blog.comments.any? %>
                <div class="space-y-3">

                  <% blog.comments.each do |comment| %>
                    <div class="rounded-md bg-gray-100 border border-gray-200 p-3">
                      <p class="text-gray-800 mb-3">
                        <strong><%= comment.user&.username %></strong>
                        <%= comment.content %>
                      </p>

                      <% if user_signed_in? && comment.user == current_user %>
                      <div class="flex flex-wrap gap-2">
                        <details class="inline-block">
                          <summary class="list-none cursor-pointer px-3 py-1.5 bg-yellow-100 hover:bg-yellow-200 text-yellow-800 rounded-md text-sm font-medium inline-block">
                            Edit
                          </summary>

                          <div class="mt-3 rounded-md bg-white border border-gray-200 p-3">
                            <%= form_with(model: [blog, comment], local: true, class: "space-y-2") do |f| %>
                              <%= f.text_area :content,
                                rows: 3,
                                class: "w-full border rounded-md p-2" %>

                              <div class="flex gap-2">
                                <%= f.submit "Save",
                                  class: "px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white rounded-md text-sm" %>
                              </div>
                            <% end %>
                          </div>
                        </details>


                        <%= button_to "Delete",
                        blog_comment_path(blog, comment),
                        method: :delete,
                        form: {
                          onsubmit: "return confirm('Are you sure?');"
                        },
                        class: "px-3 py-1.5 bg-red-100 hover:bg-red-200 text-red-700 rounded-md text-sm font-medium" %>

                      </div>
                      <% end %>

                    </div>
                  <% end %>

                </div>
              <% else %>
                <p class="text-sm text-gray-500">No comments yet.</p>
              <% end %>
            </div>

          </div>
        </div>
      <% end %>

    <% else %>
      <p class="text-center my-10">No blogs found.</p>
    <% end %>
  </div>
</div>