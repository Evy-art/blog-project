<%= form_with(model: blog, class: "contents") do |form| %>
  <% if blog.errors.any? %>
    <div id="error_explanation" class="mt-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-700 shadow-sm">
      <h2 class="text-sm font-semibold mb-2">
        <%= pluralize(blog.errors.count, "error") %> prohibited this blog from being saved:
      </h2>

      <ul class="ml-5 list-disc space-y-1 text-sm">
        <% blog.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-6">
    <%= form.label :title, class: "block text-sm font-semibold text-gray-700" %>
    <%= form.text_field :title, class: [
      "mt-2 block w-full rounded-xl border px-4 py-3 text-gray-800 shadow-sm transition focus:ring-2 focus:ring-blue-200 focus:outline-none",
      {
        "border-gray-300 focus:border-blue-500": blog.errors[:title].none?,
        "border-red-400 focus:border-red-500 focus:ring-red-200": blog.errors[:title].any?
      }
    ] %>
  </div>

  <div class="my-6">
    <%= form.label :body, class: "block text-sm font-semibold text-gray-700" %>
    <%= form.rich_text_area :body, class: [
      "mt-2 block w-full rounded-xl border bg-white px-4 py-3 text-gray-800 shadow-sm transition focus:ring-2 focus:ring-blue-200 focus:outline-none",
      {
        "border-gray-300 focus:border-blue-500": blog.errors[:body].none?,
        "border-red-400 focus:border-red-500 focus:ring-red-200": blog.errors[:body].any?
      }
    ] %>
  </div>

  <div class="inline">
    <%= form.submit class: "inline-flex w-full sm:w-auto items-center justify-center rounded-xl bg-blue-600 px-5 py-3 font-medium text-white shadow-md transition hover:bg-blue-500 hover:shadow-lg cursor-pointer" %>
  </div>
<% end %>