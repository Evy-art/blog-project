<h1 class="text-3xl font-bold mb-4"> My Profile <h1>

<div class="flex items-center gap-4">
<%= image_tag(
    @user.avatar.attached? ? url_for(@user.avatar) : asset_path("default-avatar.png"),
    class: "w-20 h-20 rounded-full border border-gray-300"
)%>

<div>
<p class="text-lg font-semibold"><%= @user.email %></p>
<%= link_to "Edit Profile", edit_profile_path, class: "mt-2 inline-block px-3 py-1.5 bg-green-600 hover:bg-green-500 text-white rounded-md" %>
</div>
</div>