<div class="flex flex-col items-center justify-center w-screen">
<h1 class="text-3xl font-bold mb-4"> My Profile </h1>

<div class="border rounded-md">
<div class="flex items-center gap-4">
<%= image_tag(
    @user.avatar.attached? ? url_for(@user.avatar) : asset_path("default-avatar.png"),
    class: "w-20 h-20 rounded-full border border-gray-300"
)%>

<div>
<p class="text-lg font-semibold"><%= @user.username %></p>
<p class="text-lg font-semibold"><%= @user.email %></p>

<div>
<%= link_to "Edit Profile", edit_profile_path, 
class: "mt-2 inline-block px-3 py-1.5 bg-green-600 hover:bg-green-500 text-white rounded-md" %>

<%= button_to "Delete Profile", profile_path,
method: :delete,
data: {turbo_confirm: "Are you sure you want to delete your profile? This cannot be undoene." },
class: "inline-block px-3 py-1.5 bg-red-600 hover:bg-red-500 text-white rounded-md" %>

<%= link_to "Back", blogs_path,
class: "inline-block px-3 py-1.5 bg-gray-600 hover:bg-gray-500 text-white rounded-md" %>

</div>
</div>
</div>
</div>
</div>